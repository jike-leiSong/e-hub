# Local backend proxy target used by `npm run dev`.
VITE_PROXY_TARGET=http://127.0.0.1:8080

# Prefer relative API paths when the frontend is hosted by the backend service.
# If the backend exposes controllers without this prefix, change it to an empty
# prefix or the actual context path.
VITE_API_BASE_URL=/load-aggregator-business
VITE_POINT_BASE_URL=/fnw-datamining
VITE_WS_URL=ws://127.0.0.1:8080/webSocket/
VITE_GW_ACCESS_KEY=
VITE_APP_ENV=isTest
