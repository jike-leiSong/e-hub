<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.sl.ehub.service.mapper.AggregatorDeviceDateProfitMapper">
    <resultMap id="BaseResultMap" type="cn.sl.ehub.service.vo.AggregatorDeviceDateProfit">
        <id column="id" jdbcType="INTEGER" property="id"/>
        <result column="aggregator_id" jdbcType="VARCHAR" property="aggregatorId"/>
        <result column="ent_id" jdbcType="VARCHAR" property="entId"/>
        <result column="device_base_id" jdbcType="VARCHAR" property="deviceBaseId"/>
    </resultMap>

    <insert id="batchInsert" parameterType="java.util.List">
        INSERT INTO aggregator_device_date_profit
        (aggregator_id, ent_id, resource_type_id, device_base_id, date, profit_detail, profit_detail_byte)
        VALUES
        <foreach collection="list" item="item" index="index" separator=",">
            (
            #{item.aggregatorId},
            #{item.entId},
            #{item.resourceTypeId},
            #{item.deviceBaseId},
            #{item.date},
            #{item.profitDetail},
            #{item.profitDetailByte}
            )
        </foreach>
    </insert>
</mapper>