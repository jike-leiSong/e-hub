<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.sl.ehub.service.mapper.AggregatorDateApplyDetailMapper">
    <resultMap id="BaseResultMap" type="cn.sl.ehub.service.vo.AggregatorDateApplyDetail">
        <id column="id" jdbcType="INTEGER" property="id"/>
        <result column="aggregator_id" jdbcType="VARCHAR" property="aggregatorId"/>
        <result column="date" jdbcType="VARCHAR" property="date"/>
        <result column="apply_status" jdbcType="VARCHAR" property="applyStatus"/>
        <result column="win_status" jdbcType="VARCHAR" property="winStatus"/>
        <result column="apply_by" jdbcType="VARCHAR" property="applyBy"/>
        <result column="create_time" jdbcType="VARCHAR" property="createTime"/>
        <result column="update_time" jdbcType="VARCHAR" property="updateTime"/>
    </resultMap>

    <insert id="batchInsert" parameterType="java.util.List">
        INSERT INTO aggregator_date_apply_detail
        (aggregator_id, date, apply_type, apply_status, apply_time, win_status, apply_by, create_time, update_time)
        VALUES
        <foreach collection="list" item="item" index="index" separator=",">
            (
            #{item.aggregatorId},
            #{item.date},
            #{item.applyType},
            #{item.applyStatus},
            #{item.applyTime},
            #{item.winStatus},
            #{item.applyBy},
            #{item.createTime},
            #{item.updateTime}
            )
        </foreach>
    </insert>
</mapper>