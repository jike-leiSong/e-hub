<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.sl.ehub.service.mapper.AggregatorDeviceDeliveryPowerPercentMapper">
    <resultMap id="BaseResultMap" type="cn.sl.ehub.service.vo.AggregatorDeviceDeliveryPowerPercent">
        <id column="id" jdbcType="INTEGER" property="id"/>
        <result column="resource_type_id" jdbcType="VARCHAR" property="resourceTypeId"/>
        <result column="time" jdbcType="VARCHAR" property="time"/>
    </resultMap>

    <insert id="batchInsert" parameterType="java.util.List">
        INSERT INTO aggregator_device_delivery_power_percent
        (resource_type_id, date, time, detail)
        VALUES
        <foreach collection="list" item="item" index="index" separator=",">
            (
            #{item.resourceTypeId},
            #{item.date},
            #{item.time},
            #{item.detail}
            )
        </foreach>
    </insert>
</mapper>