<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.sl.ehub.service.mapper.BigScreenEntTodayRateMapper">
    <resultMap id="BaseResultMap" type="cn.sl.ehub.service.vo.BigScreenEntTodayRate">
        <id column="id" jdbcType="BIGINT" property="id"/>
        <result column="ent_id" jdbcType="VARCHAR" property="entId"/>
        <result column="ent_name" jdbcType="VARCHAR" property="entName"/>
        <result column="total_quantity" jdbcType="DOUBLE" property="totalQuantity"/>
        <result column="finish_quantity" jdbcType="DOUBLE" property="finishQuantity"/>
        <result column="finish_rate" jdbcType="DOUBLE" property="finishRate"/>
        <result column="area" jdbcType="DOUBLE" property="area"/>
        <result column="total_square" jdbcType="INTEGER" property="totalSquare"/>
        <result column="finish_square" jdbcType="DOUBLE" property="finishSquare"/>
    </resultMap>

    <insert id="batchInsert" parameterType="java.util.List">
        INSERT INTO big_screen_ent_today_rate
        (ent_id, ent_name, time, total_quantity, finish_quantity, finish_rate, area)
        VALUES
        <foreach collection="list" item="item" index="index" separator=",">
            (
            #{item.entId},
            #{item.entName},
            #{item.time},
            #{item.totalQuantity},
            #{item.finishQuantity},
            #{item.finishRate},
            #{item.area}
            )
        </foreach>
    </insert>

    <select id="getBigScreenEntTodayRateList" resultType="cn.sl.ehub.service.vo.BigScreenEntTodayRate">
        SELECT * FROM big_screen_ent_today_rate WHERE time &lt;= #{time} ORDER BY time DESC LIMIT 4;
    </select>
</mapper>