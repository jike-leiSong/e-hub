<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.sl.ehub.service.mapper.AggregatorDateHolidayMapper">
    <resultMap id="BaseResultMap" type="cn.sl.ehub.service.vo.AggregatorDateHoliday">
        <id column="id" jdbcType="INTEGER" property="id"/>
        <result column="year" jdbcType="VARCHAR" property="year"/>
        <result column="date" jdbcType="VARCHAR" property="date"/>
    </resultMap>
    <insert id="batchInsert" parameterType="java.util.List">
        INSERT INTO aggregator_date_holiday
        ( date, year, legal_holiday)
        VALUES
        <foreach collection="list" item="item" index="index" separator=",">
            (
            #{item.date},
            #{item.year},
            #{item.legalHoliday}
            )
        </foreach>
    </insert>
</mapper>