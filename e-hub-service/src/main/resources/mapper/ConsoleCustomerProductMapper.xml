<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.sl.ehub.service.mapper.ConsoleCustomerProductMapper">

    <resultMap id="BaseResultMap" type="cn.sl.ehub.service.vo.ConsoleCustomerProduct">
        <id column="id" jdbcType="INTEGER" property="id"/>
        <result column="user_id" jdbcType="VARCHAR" property="userId"/>
        <result column="customer_id" jdbcType="VARCHAR" property="customerId"/>
        <result column="product_code" jdbcType="VARCHAR" property="productCode"/>
        <result column="enabled" jdbcType="INTEGER" property="enabled"/>
        <result column="valid_from" jdbcType="VARCHAR" property="validFrom"/>
        <result column="valid_to" jdbcType="VARCHAR" property="validTo"/>
        <result column="create_time" jdbcType="VARCHAR" property="createTime"/>
        <result column="update_time" jdbcType="VARCHAR" property="updateTime"/>
    </resultMap>

    <select id="listEnabledProductCodes" resultType="java.lang.String">
        SELECT DISTINCT product_code
        FROM console_customer_product
        WHERE enabled = 1
          AND (valid_from IS NULL OR valid_from = '' OR valid_from &lt;= CURDATE())
          AND (valid_to IS NULL OR valid_to = '' OR valid_to &gt;= CURDATE())
        <choose>
            <when test="userId != null and userId != '' and customerIds != null and customerIds.size > 0">
                AND (
                    user_id = #{userId}
                    OR customer_id IN
                    <foreach collection="customerIds" item="customerId" open="(" separator="," close=")">
                        #{customerId}
                    </foreach>
                )
            </when>
            <when test="userId != null and userId != ''">
                AND user_id = #{userId}
            </when>
            <when test="customerIds != null and customerIds.size > 0">
                AND customer_id IN
                <foreach collection="customerIds" item="customerId" open="(" separator="," close=")">
                    #{customerId}
                </foreach>
            </when>
            <otherwise>
                AND 1 = 0
            </otherwise>
        </choose>
        ORDER BY product_code
    </select>

    <select id="listByUserIdsOrCustomerIds" resultMap="BaseResultMap">
        SELECT id,
               user_id,
               customer_id,
               product_code,
               enabled,
               valid_from,
               valid_to,
               create_time,
               update_time
        FROM console_customer_product
        WHERE enabled = 1
          AND (valid_from IS NULL OR valid_from = '' OR valid_from &lt;= CURDATE())
          AND (valid_to IS NULL OR valid_to = '' OR valid_to &gt;= CURDATE())
        <choose>
            <when test="userIds != null and userIds.size > 0 and customerIds != null and customerIds.size > 0">
                AND (
                    user_id IN
                    <foreach collection="userIds" item="userId" open="(" separator="," close=")">
                        #{userId}
                    </foreach>
                    OR customer_id IN
                    <foreach collection="customerIds" item="customerId" open="(" separator="," close=")">
                        #{customerId}
                    </foreach>
                )
            </when>
            <when test="userIds != null and userIds.size > 0">
                AND user_id IN
                <foreach collection="userIds" item="userId" open="(" separator="," close=")">
                    #{userId}
                </foreach>
            </when>
            <when test="customerIds != null and customerIds.size > 0">
                AND customer_id IN
                <foreach collection="customerIds" item="customerId" open="(" separator="," close=")">
                    #{customerId}
                </foreach>
            </when>
            <otherwise>
                AND 1 = 0
            </otherwise>
        </choose>
        ORDER BY customer_id, user_id, product_code
    </select>

    <delete id="deleteByUserId">
        DELETE FROM console_customer_product
        WHERE user_id = #{userId}
    </delete>
</mapper>
