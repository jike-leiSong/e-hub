<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.sl.ehub.service.mapper.AggregatorAvgRtChartMapper">
    <resultMap id="BaseResultMap" type="cn.sl.ehub.service.vo.AggregatorAvgRtChart">
        <id column="id" jdbcType="INTEGER" property="id"/>
        <result column="aggregator_id" jdbcType="VARCHAR" property="aggregatorId"/>
        <result column="resource_type" jdbcType="VARCHAR" property="resourceType"/>
        <result column="avg_rt_chart" jdbcType="VARCHAR" property="avgRtChart"/>
        <result column="date" jdbcType="VARCHAR" property="date"/>
    </resultMap>

    <insert id="batchInsert" parameterType="java.util.List">
        INSERT INTO aggregator_avg_rt_chart
        (aggregator_id, resource_type, date, avg_rt_chart)
        VALUES
        <foreach collection="list" item="item" index="index" separator=",">
            (
            #{item.aggregatorId},
            #{item.resourceType},
            #{item.date},
            #{item.avgRtChart}
            )
        </foreach>
    </insert>
</mapper>